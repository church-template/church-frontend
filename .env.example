# 백엔드 API base — 환경마다 다른 유일한 값. context-path 없음(루트 /).
# NEXT_PUBLIC_* 는 빌드 타임에 인라인되므로 빌드 시점에 반드시 설정돼 있어야 한다(없으면 ""로 인라인 → 전 API 호출 실패).
# 로컬: 아래 값. 운영(Vercel): 대시보드 Environment Variables에 https://api.<도메인> 등록 → vercel build가 주입.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# 검색엔진 소유확인 (선택 — docs/seo-operations.md 절차로 발급 후 Vercel env에 설정)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
